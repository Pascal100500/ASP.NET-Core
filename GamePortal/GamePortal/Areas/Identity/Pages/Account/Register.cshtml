@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="login-container-logpas">
    <h2>Регистрация</h2>

    <div class="identity-info">
        <strong>Подсказка для проверки проекта</strong>
        <ul>
            <li><b>Администратор</b>: admin@example.com / Admin123!</li>
            <li><b>Пользователь</b>: test1@example.com / Passw0rd!</li>
        </ul>

        <strong>Правила пароля (учебный режим):</strong>
        <ul>
            <li>Минимальная длина: <b>6</b> символов</li>
            <li>Не требуется: цифры, строчные/заглавные буквы, спецсимволы</li>
        </ul>
    </div>

    <form method="post" asp-route-returnUrl="@Model.ReturnUrl">

        <div asp-validation-summary="ModelOnly" class="validation-error-logpas"></div>

        <div class="form-group-logpas">
            <label asp-for="Input.Email">Email</label>
            <input asp-for="Input.Email" class="input-field-logpas" autocomplete="username" placeholder="test1@example.com" />
            <span asp-validation-for="Input.Email" class="validation-error-logpas"></span>
        </div>

        <div class="form-group-logpas">
            <label asp-for="Input.Password">Пароль</label>
            <input asp-for="Input.Password" class="input-field-logpas" id="registerPassword" autocomplete="new-password" placeholder="123456" />
            <span asp-validation-for="Input.Password" class="validation-error-logpas"></span>
        </div>

        <div class="form-group-logpas">
            <label asp-for="Input.ConfirmPassword">Подтвердите пароль</label>
            <input asp-for="Input.ConfirmPassword" class="input-field-logpas" id="registerConfirmPassword" autocomplete="new-password" placeholder="123456" />
            <span asp-validation-for="Input.ConfirmPassword" class="validation-error"></span>
        </div>

        <div class="form-group-logpas checkbox-group-logpas">
            <input type="checkbox" id="showPasswordCheckbox" />
            <label for="showPasswordCheckbox">Показывать пароль</label>
        </div>

        <button type="submit" class="btn-main-logpas">
            Зарегистрироваться
        </button>

        <div class="login-links-logpas">
            <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">
                Уже есть аккаунт? Войти
            </a>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const checkbox = document.getElementById("showPasswordCheckbox");
        const password = document.getElementById("registerPassword");
        const confirm = document.getElementById("registerConfirmPassword");

        checkbox.addEventListener("change", function () {
            const type = this.checked ? "text" : "password";
            password.type = type;
            confirm.type = type;
        });
    </script>
}


