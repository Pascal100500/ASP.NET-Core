<!DOCTYPE html>
<html lang="ru">
<head>
    @RenderSection("Styles", required: false)
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

    <header>
        <h1>🎮 Game Portal V1.4.3</h1>
    </header>

    <nav>
        <a asp-page="/Index">Главная</a>
        @if (User.IsInRole("Admin"))
        {
        <a asp-page="/AddGame">Добавить игру</a>
        <a asp-page="/News/Create">Добавить новость</a>
        }
        <a asp-page="/About">О разработчике</a>
        <a asp-page="/History">История изменений</a>

        <div class="user-panel">
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <span class="user-greeting">👤 Привет, @User.Identity.Name!</span>

                <form asp-area="Identity"
                      asp-page="/Account/Logout"
                      method="post"
                      class="logout-form">
                    <button type="submit" class="btn-logout">
                        Выйти
                    </button>
                </form>
            }
            else
            {
                <a class="login-link" asp-area="Identity" asp-page="/Account/Login">Вход</a>
                <a class="register-link" asp-area="Identity" asp-page="/Account/Register">Регистрация</a>
            }
        </div>

    </nav>

    <div class="main-wrapper">

        <aside class="left-menu">

            <a asp-page="/OnlineGames/Index">Онлайн игры</a>

            <a asp-page="/Games/Index">Купить игру</a>

            <a asp-page="/Games/Sale">Распродажа</a>

            <a asp-page="/Games/Top">Топ 10 Игр</a>

            <a asp-page="/News/Index">Новости</a>

        </aside>

        <main>
            @RenderBody()
        </main>

    </div>

    <footer>
        <!--Аудиоплеер-->
        <audio id="site-audio" controls loop style="width:300px"> <!--Задал ширину плееру, чтобы не сужать полосу перемотки-->
            <source src="/music/theme.mp3" type="audio/mpeg">
            Your browser does not support the audio element.
        </audio>

        <p>© @DateTime.Now.Year</p>
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <!--
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    -->
    @RenderSection("Scripts", required: false)

    <!--Скрипты для плеера. чтобы он сохранял состояние при перезагрузке страниц-->
    <script>

             document.addEventListener("DOMContentLoaded", function () {

            const audio = document.getElementById("site-audio");

            // Установить громкость 20%
            audio.volume = 0.2;

            // Восстановить позицию
            const savedTime = localStorage.getItem("audioTime");
            if (savedTime) {
                audio.currentTime = parseFloat(savedTime);
            }

            // Восстановить состояние воспроизведения
            const wasPlaying = localStorage.getItem("audioPlaying");
            if (wasPlaying === "true") {
                audio.play().catch(() => {}); // Чтобы плеер не падал при нажатии браузерной кнопки "Назад"
            }
        });

        // Сохранить позицию и состояние при уходе
        window.addEventListener("beforeunload", function () {

            const audio = document.getElementById("site-audio");

            localStorage.setItem("audioTime", audio.currentTime);
            localStorage.setItem("audioPlaying", !audio.paused);
        });
    </script>

</body>
</html>